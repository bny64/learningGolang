{
    "version": "0.2.0",
    "configurations": [
      
        {
            "name": "Launch Bookings App (cmd/web)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/src/bookings/cmd/web",
            "cwd": "${workspaceFolder}/src/bookings",
            "env": {},
            "args": []
        },
        {
            "name": "Launch Current File",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${file}",
            "cwd": "${workspaceFolder}/src/bookings"
        },
        {
            "name": "Launch Package Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/src/bookings/...",
            "cwd": "${workspaceFolder}/src/bookings"
        }
    ]
}